# PostgreSQL with pgvector. For Supabase, copy the "Session pooler" URI and
# change the scheme to postgresql+psycopg, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/rag_assistant_v2
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
# Optional override for Groq's OpenAI-compatible base URL:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
ENABLE_RERANKING=false
ENABLE_QUERY_REWRITING=true
# Optional Redis embedding cache:
# REDIS_URL=redis://localhost:6379/0
